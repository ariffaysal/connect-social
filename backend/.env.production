# Backend server
PORT=3001

# Comma-separated list of allowed frontend origins
# IMPORTANT: Add your actual Vercel domain here
CORS_ORIGIN=https://connect-social-five.vercel.app

# PostgreSQL via Neon
DATABASE_URL=postgresql://neondb_owner:npg_N0t5BaxYlrTz@ep-jolly-sun-azftyi1j-pooler.c-3.ap-southeast-1.aws.neon.tech/connect_social?sslmode=require&channel_binding=require

# TLS is on by default for Postgres
DB_SSL=true

# Set to false in production (use migrations instead of auto-sync)
DB_SYNCHRONIZE=false

# JWT signing secret - REQUIRED. Generate with: openssl rand -base64 48
# THIS IS JUST A PLACEHOLDER - YOU MUST CHANGE THIS!
JWT_SECRET=change-me-to-a-long-random-value-min-32-chars
