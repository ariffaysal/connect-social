# ConnectSocial Backend - Production Environment
# Reference for self-hosted / local deployment. Copy the values you need into
# your host's environment (or .env) — do NOT commit real secrets to this file.

# =============================================================================
# DATABASE (MySQL)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=connect_social

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed frontend origins (or * to allow all).
# Include your deployed frontend AND localhost for development.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =============================================================================
# SERVER CONFIG
# =============================================================================
PORT=3001

# Never auto-sync a production schema.
DB_SYNCHRONIZE=false
# Run the checked-in performance migrations during startup.
DB_MIGRATIONS_RUN=true

# =============================================================================
# NOTES
# =============================================================================
# - WebSocket (/ws) requires a long-running server; it works fine locally or
#   on any persistent Node host (Railway, Render, VPS).
# - Uploaded images are stored in the backend/uploads directory (needs
#   persistent storage on your host).
# - Set DB_SYNCHRONIZE=false and use migrations for production stability.
