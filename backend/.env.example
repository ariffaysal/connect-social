[TEMPLATE]
# Backend server
PORT=3001
# Comma-separated list of allowed frontend origins (or * to allow all)
CORS_ORIGIN=http://localhost:3000

# MySQL database (local dev / MySQL hosts)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=connect_social
# PostgreSQL alternative (e.g. Neon). When DATABASE_URL starts with `postgres`,
# the backend uses the pg driver and ignores DB_HOST/DB_PORT/... above.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# TLS is on by default for Postgres; set DB_SSL=false to disable it.
# DB_SSL=false
# Set to false in production (use migrations instead of auto-sync)
DB_SYNCHRONIZE=true

# JWT signing secret - REQUIRED. The backend refuses to start when this is
# missing, shorter than 32 chars, or still a placeholder. Generate a strong
# value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value