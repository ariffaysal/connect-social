# Backend server
PORT=3001
# Comma-separated list of allowed frontend origins (or * to allow all)
CORS_ORIGIN=http://localhost:3000

# MySQL database (local dev / MySQL hosts)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=connect_social
# Set to false in production (use migrations instead of auto-sync)
DB_SYNCHRONIZE=true
# Set true for a production deploy after the schema baseline exists.
DB_MIGRATIONS_RUN=false

# JWT signing secret - REQUIRED. The backend refuses to start when this is
# missing, shorter than 32 chars, or still a placeholder. Generate a strong
# value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Session lifetime (any ms/vercel string, e.g. 30m, 12h, 1d). Default 12h.
# Deactivation and password resets revoke immediately regardless of this value.
JWT_EXPIRES_IN=12h

# Number of reverse-proxy hops in front of the API (Caddy = 1).
# Set to false when the API port is reachable directly (no proxy), otherwise
# clients can spoof X-Forwarded-For and bypass per-IP rate limits.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Demo data + first account
# ---------------------------------------------------------------------------
# Demo seeding creates accounts with KNOWN passwords (admin/password, ...) plus
# sample posts. Default: enabled when NODE_ENV is not "production", disabled in
# production. Never enable it on a reachable deployment.
#   true  -> always seed (demos, staging)
#   false -> never seed
SEED_DEMO_DATA=false

# First SuperAdmin for a deployment without demo seeding (used only when the
# user table is empty). Remove BOOTSTRAP_ADMIN_PASSWORD after the first boot.
#BOOTSTRAP_ADMIN_USERNAME=admin
#BOOTSTRAP_ADMIN_PASSWORD=at-least-12-characters
#BOOTSTRAP_ADMIN_EMAIL=admin@company.com
#BOOTSTRAP_ADMIN_FULL_NAME=Site Administrator

# ---------------------------------------------------------------------------
# Direct messages (see the messages module)
# ---------------------------------------------------------------------------
# How long a live conversation message is kept before it is deleted. Default 60.
MESSAGE_RETENTION_MINUTES=60

# Mirror messages into the management audit table. This is surveillance, so it
# is OFF by default in production and ON outside production (local dev).
#   true -> always mirror   false -> never mirror
#MESSAGE_AUDIT_ENABLED=false

# How long the audit copy is kept, in hours. Default 24. Set 0 to keep audit
# rows forever (an explicit choice - it means private messages are permanent).
MESSAGE_AUDIT_RETENTION_HOURS=24
