# Backend server
PORT=3001
# Comma-separated list of allowed frontend origins (or * to allow all)
CORS_ORIGIN=http://localhost:3000

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
