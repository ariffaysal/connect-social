# ConnectSocial — Docker Compose deployment configuration.
#
# On the server:
#   cp .env.example .env
#   # then edit the values below (never commit the real .env — it is gitignored)
#
# Full runbook: README.md -> "Deployment".

# =============================================================================
# Domain & TLS
# =============================================================================
# Public hostname that resolves to this server. Caddy will request a Let's
# Encrypt certificate for it automatically, so DNS must point here BEFORE the
# first start and inbound ports 80 + 443 must be open.
#
# Free option: create a subdomain at https://www.duckdns.org (e.g.
# connectsocial.duckdns.org) and set its IP to the server's public IP.
DOMAIN=connectsocial.duckdns.org

# Optional ACME contact address (receives certificate-expiry warnings).
ACME_EMAIL=

# =============================================================================
# App URLs
# =============================================================================
# Public URL of the API. Keep it on the same origin as the app — Caddy strips
# the /api prefix and forwards to the backend.
#
# NOTE: this value is compiled into the frontend bundle at image build time;
# changing the domain later requires `docker compose up -d --build web`.
NEXT_PUBLIC_API_URL=https://connectsocial.duckdns.org/api

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=https://connectsocial.duckdns.org

# =============================================================================
# Database
# =============================================================================
DB_NAME=connect_social
DB_USERNAME=connect_social
# Strong password for the database. It initializes the app user AND the MySQL
# root account; MySQL is never published outside the compose network.
DB_PASSWORD=change-me-to-a-strong-db-password

# =============================================================================
# Backend
# =============================================================================
# REQUIRED and must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# Number of reverse-proxy hops in front of the API (Caddy = 1). Only set this
# to `false` if the API is ever exposed directly without a proxy.
TRUST_PROXY=1

# =============================================================================
# First boot vs. normal operation
# =============================================================================
# The repository has no baseline migration, and production mode never creates
# the schema automatically. So the FIRST boot must run with:
#
#   NODE_ENV=development
#   DB_SYNCHRONIZE=true
#   DB_MIGRATIONS_RUN=false
#
# which creates every table. NODE_ENV=development would *also* seed accounts
# with known passwords (admin/password), so the first boot explicitly disables
# that and creates one SuperAdmin from BOOTSTRAP_ADMIN_* instead:
#
#   SEED_DEMO_DATA=false
#   BOOTSTRAP_ADMIN_USERNAME=admin
#   BOOTSTRAP_ADMIN_PASSWORD=<openssl rand -base64 24>
#
# After the first successful start, switch to the production values below,
# remove BOOTSTRAP_ADMIN_PASSWORD, and re-apply:
#
#   docker compose up -d
#
NODE_ENV=development
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# Never create accounts with known passwords (admin/password, guest/guest123)
# on this deployment. Set true only for a throwaway demo/staging environment.
SEED_DEMO_DATA=false

# First SuperAdmin, read only when the user table is empty. Remove the password
# from this file after the first successful boot.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-characters

# Session lifetime. Tokens are re-validated per request and revoked when the
# account is deactivated or its password changes, so this only bounds how long
# a *stolen* token stays useful. Default 12h.
JWT_EXPIRES_IN=12h

# =============================================================================
# Direct messages
# =============================================================================
# Live conversation retention, in minutes (default 60).
MESSAGE_RETENTION_MINUTES=60

# Mirror messages into the management audit table. Surveillance, so it is OFF
# by default in production; set true only if management monitoring of private
# messages is intended. Reads of the archive are written to the activity log.
MESSAGE_AUDIT_ENABLED=false

# How long the audit copy is kept, in hours (default 24). Set 0 to keep audit
# rows forever.
MESSAGE_AUDIT_RETENTION_HOURS=24

# Production values (use these after the first boot):
# NODE_ENV=production
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true
